# Copia este archivo como .env y completa las credenciales creadas en MariaDB.
GIOVA_CATALOG_ENABLED=true
GIOVA_DB_HOST=host.docker.internal
GIOVA_DB_PORT=3306
GIOVA_DB_NAME=giova_v1
GIOVA_DB_USER=giova_app
GIOVA_DB_PASSWORD=
GIOVA_FLYWAY_USER=giova_migrator
GIOVA_FLYWAY_PASSWORD=
# Carpeta privada del backend; en Docker se reemplaza por el volumen interno.
GIOVA_DOCUMENTS_ROOT=storage/documents
GIOVA_DOCUMENTS_MAX_BYTES=10485760
# Sitio publico: empresa que se muestra si el dominio no esta en tenant_hosts.
GIOVA_SITE_DEFAULT_TENANT=GIOVA
# Permite ?empresa=<codigo|slug> solo desde localhost, para demostrar las dos
# empresas sin configurar dominios. Pon false al publicar.
GIOVA_SITE_ALLOW_LOCAL_OVERRIDE=true
# Pon GIOVA_OECE_ENABLED=true solo si aceptas que el backend consulte la API
# publica de OECE. La URL debe apuntar al release package OCDS, no al portal.
GIOVA_OECE_ENABLED=true
GIOVA_OECE_BASE_URL=https://contratacionesabiertas.oece.gob.pe/api/v1/releases
GIOVA_OECE_SYNC_CRON=0 0 */6 * * *
GIOVA_OECE_CONNECT_TIMEOUT_SECONDS=10
GIOVA_OECE_READ_TIMEOUT_SECONDS=30
GIOVA_OECE_PAGE_SIZE=50
# Paginas maximas por ejecucion; el resto continua en la siguiente sincronizacion.
GIOVA_OECE_MAX_PAGES=60
